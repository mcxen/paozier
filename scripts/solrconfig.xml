<?xml version="1.0" encoding="UTF-8"?>
<config>
  <luceneMatchVersion>9.11</luceneMatchVersion>

  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <lib dir="${solr.install.dir:../../../..}/modules/extraction/lib" regex=".*\.jar"/>
  <lib dir="${solr.install.dir:../../../..}/modules/analysis-extras/lib" regex=".*\.jar"/>

  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <str name="df">_text_</str>
      <str name="hl">true</str>
      <str name="hl.fl">content,title,file_name</str>
      <str name="hl.snippets">3</str>
      <str name="hl.fragsize">200</str>
      <str name="rows">20</str>
    </lst>
  </requestHandler>

  <requestHandler name="/update/extract" class="solr.extraction.ExtractingRequestHandler" startup="lazy">
    <lst name="defaults">
      <str name="fmap.content">content</str>
      <str name="fmap.dc.title">title</str>
      <str name="fmap.dc.creator">author</str>
      <str name="fmap.meta.page-count">pages</str>
      <str name="lowernames">true</str>
      <str name="captureAttr">false</str>
      <str name="uprefix">ignored_</str>
    </lst>
  </requestHandler>

  <requestHandler name="/update" class="solr.UpdateRequestHandler"/>

  <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
    <lst name="invariants">
      <str name="q">*:*</str>
    </lst>
  </requestHandler>
</config>
